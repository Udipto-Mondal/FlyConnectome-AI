# ==============================================================================
# FlyConnectome AI — Environment Configuration Template
# ==============================================================================

# Server & Runtime Environment
PROJECT_NAME="FlyConnectome AI"
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]

# Connectome Scientific Data Source (Phase 1 Integration)
# Official Drosophila Male CNS Connectome (v1.0) via neuPrint
NEUPRINT_SERVER=https://neuprint.janelia.org
NEUPRINT_DATASET=cns
NEUPRINT_TOKEN=your_neuprint_auth_token_here
CONNECTOME_CACHE_DIR=./data/cache/connectome

# Agent & LLM Orchestration (Phase 5 & Phase 7)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=60

# Literature Retrieval (Phase 6 Integration)
EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest/search
PUBMED_EMAIL=researcher@flyconnectome.ai
